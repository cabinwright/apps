{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabinwright.github.io/apps/schema/app.schema.json",
  "title": "Cabinwright apps entry (apps/<id>.json)",
  "type": "object",
  "required": ["id", "name", "summary", "author", "category", "versions"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "The NEMESIS package id: the file name, and NEMESIS.data's id.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "summary": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 4000},
    "author": {"type": "string", "minLength": 1, "maxLength": 60},
    "homepage": {"type": "string", "maxLength": 300, "pattern": "^https://[^\\s]+$"},
    "category": {"type": "string", "enum": ["fixes", "apps", "projection", "system", "tools", "fun"]},
    "deprecated": {
      "description": "Retires the app: why, in plain words for drivers. The store stops offering it but keeps showing it to cars that have it, with Remove. Entries are never deleted.",
      "type": "string",
      "maxLength": 300
    },
    "withdrawn": {
      "description": "Pulled for safety: why, in plain words. Like deprecated, and the store also urges cars that have it to remove it.",
      "type": "string",
      "maxLength": 300
    },
    "replaced_by": {
      "description": "With deprecated or withdrawn: the id of the app that takes its place.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$"
    },
    "versions": {
      "description": "Newest first.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "url", "sha256", "firmware", "tier"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string", "maxLength": 32, "pattern": "^[0-9]+(\\.[0-9]+)*$"},
          "url": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^/?#\\s]+/[^/?#\\s]+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "firmware": {
            "description": "Exact firmware strings, or [\"*\"] for packages that don't write to the system.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "maxLength": 80, "pattern": "^(\\*|[A-Za-z0-9][A-Za-z0-9._-]*)$"}
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*(>=[0-9]+(\\.[0-9]+)*)?$"
            }
          },
          "tier": {
            "description": "app: top-level APKs only. tweaks: tweaks/<id>/ folders, lib/ and top-level APKs. system: anything, only for cabinwright.store. CI derives it from the zip.",
            "type": "string",
            "enum": ["app", "tweaks", "system"]
          },
          "capabilities": {
            "description": "What the app asks the store for, each with the reason shown to the driver.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tweaks": {"type": "string", "minLength": 1, "maxLength": 120},
              "logs": {"type": "string", "minLength": 1, "maxLength": 120},
              "settings": {"type": "string", "minLength": 1, "maxLength": 120},
              "root": {"type": "string", "minLength": 1, "maxLength": 120}
            }
          },
          "notes": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
